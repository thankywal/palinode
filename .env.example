# Leave everything unset and the demo still runs. The ledger falls back to
# memory and the connectors run against an in memory world.

# Google Cloud. Setting a project switches the ledger to Firestore.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Models. The classifier sits inline on every tool call, so it needs Flash.
PALINODE_CLASSIFIER_MODEL=gemini-3.5-flash
PALINODE_PLANNER_MODEL=gemini-3.5-flash

# Regulated tenants run the classifier in their own VPC instead.
PALINODE_SOVEREIGN_MODE=false
PALINODE_SOVEREIGN_MODEL=gemma-3-12b-it

# How long T2 and T3 actions are held before they reach the world. Anything
# caught inside this window is a true undo rather than a compensation.
PALINODE_COOLING_OFF_SECONDS=30

# Unrecoverable exposure an agent may run up per hour before it is dropped to
# propose only.
PALINODE_DEFAULT_BUDGET_USD=500

# Refuse any action whose author did not say how to take it back.
PALINODE_REQUIRE_CONTRACT=true
